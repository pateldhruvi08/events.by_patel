PROJECT_NAME="Event Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=event_management_db
# Use Postgres connection URL for Vercel production deployment
# DATABASE_URL=postgresql://postgres:password@localhost:5432/event_management_db
DATABASE_URL=sqlite:///./event_management.db

SECRET_KEY=your-super-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# Google Auth
GOOGLE_CLIENT_ID="your-client-id-here.apps.googleusercontent.com"
